[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/item.gd" id="1_item"]

[sub_resource type="SceneReplicationConfig" id="replication"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:rotation")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:holder")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:holder_slot")
properties/3/spawn = true
properties/3/replication_mode = 2

[node name="Item" type="RigidBody3D" groups=["items"]]
script = ExtResource("1_item")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("replication")
